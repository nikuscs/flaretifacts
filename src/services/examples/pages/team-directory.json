{
  "name": "team-directory",
  "title": "Team directory",
  "emoji": "👋",
  "description": "A people page that stores everyone once: one /people list in state feeds the DataTable (avatar column, select filters, role and start date only on wide screens, city in the row panel), a face stack, the team leads and the new joiners, each a People block picking its rows with where (lead: \"yes\", new: \"yes\"). One Filters row filters every block through where; a Dropdown of links, an on-call Table and a birthday List with pages. Start here for teams, rosters, members, creators or leaderboards.",
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "gap": "lg"
        },
        "children": [
          "head",
          "numbers",
          "teamPick",
          "row",
          "directoryCard",
          "row2"
        ]
      },
      "head": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "subtitle",
          "headRow"
        ]
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "24 people in 4 teams, from the HR sheet. Updated 18 Nov. Pick a team to filter the whole page.",
          "variant": "muted"
        },
        "children": []
      },
      "headRow": {
        "type": "Stack",
        "props": {
          "direction": "horizontal",
          "gap": "lg"
        },
        "children": [
          "everyone",
          "handbook"
        ]
      },
      "everyone": {
        "type": "People",
        "props": {
          "layout": "stack",
          "max": 7,
          "people": {
            "$state": "/people"
          }
        },
        "children": []
      },
      "handbook": {
        "type": "Dropdown",
        "props": {
          "label": "Handbook",
          "emoji": "📚",
          "items": [
            {
              "label": "Onboarding",
              "url": "https://example.com/handbook/onboarding",
              "emoji": "🚀",
              "description": "Your first two weeks"
            },
            {
              "label": "Holidays and time off",
              "url": "https://example.com/handbook/time-off",
              "emoji": "🌴",
              "description": "25 days, booked in the HR app"
            },
            {
              "label": "Org chart",
              "url": "https://example.com/handbook/org-chart",
              "emoji": "🧭"
            },
            {
              "label": "Expenses",
              "url": "https://example.com/handbook/expenses",
              "emoji": "🧾",
              "description": "Receipts within 30 days"
            }
          ]
        },
        "children": []
      },
      "numbers": {
        "type": "KeyNumbers",
        "props": {
          "items": [
            {
              "label": "People",
              "value": {
                "$state": "/stats/people"
              }
            },
            {
              "label": "Teams",
              "value": 4
            },
            {
              "label": "Cities",
              "value": 2,
              "context": "and 6 remote"
            },
            {
              "label": "Joined this quarter",
              "value": {
                "$state": "/stats/joined"
              },
              "context": "👋 say hi"
            }
          ]
        },
        "children": []
      },
      "teamPick": {
        "type": "Filters",
        "props": {
          "label": "Team",
          "all": "Everyone",
          "value": {
            "$bindState": "/team"
          },
          "options": [
            {
              "value": "Design",
              "emoji": "🎨",
              "count": 4
            },
            {
              "value": "Engineering",
              "emoji": "🛠️",
              "count": 8
            },
            {
              "value": "Sales",
              "emoji": "💼",
              "count": 6
            },
            {
              "value": "Support",
              "emoji": "🎧",
              "count": 6
            }
          ]
        },
        "children": []
      },
      "row": {
        "type": "Grid",
        "props": {
          "columns": "2"
        },
        "children": [
          "leadsCard",
          "newCard"
        ]
      },
      "leadsCard": {
        "type": "Card",
        "props": {
          "title": "🧑‍✈️ Team leads"
        },
        "children": [
          "leads"
        ]
      },
      "leads": {
        "type": "People",
        "props": {
          "people": {
            "$state": "/people"
          },
          "where": {
            "team": {
              "$state": "/team"
            },
            "lead": "yes"
          }
        },
        "children": []
      },
      "newCard": {
        "type": "Card",
        "props": {
          "title": "🌱 New this quarter",
          "description": "Started since October"
        },
        "children": [
          "newList"
        ]
      },
      "newList": {
        "type": "People",
        "props": {
          "people": {
            "$state": "/people"
          },
          "where": {
            "new": "yes"
          }
        },
        "children": []
      },
      "directoryCard": {
        "type": "Card",
        "props": {
          "title": "👥 Everyone",
          "description": "Search, sort, or filter by city and status"
        },
        "children": [
          "directory"
        ]
      },
      "directory": {
        "type": "DataTable",
        "props": {
          "pageSize": 10,
          "sort": {
            "key": "avatar",
            "direction": "asc"
          },
          "columns": [
            {
              "key": "avatar",
              "label": "Name",
              "type": "avatar",
              "labelKey": "name"
            },
            {
              "key": "role",
              "label": "Role",
              "show": "wide"
            },
            {
              "key": "team",
              "label": "Team",
              "type": "badge",
              "tones": {
                "Design": "info",
                "Engineering": "neutral",
                "Sales": "success",
                "Support": "warning"
              },
              "show": "wide"
            },
            {
              "key": "city",
              "label": "City",
              "show": "detail"
            },
            {
              "key": "status",
              "label": "Status",
              "type": "badge",
              "tones": {
                "🟢 Online": "success",
                "🌴 On holiday": "info",
                "🔴 Busy": "danger"
              }
            },
            {
              "key": "started",
              "label": "Started",
              "type": "date",
              "show": "wide"
            }
          ],
          "filters": [
            {
              "key": "city"
            },
            {
              "key": "status"
            }
          ],
          "where": {
            "team": {
              "$state": "/team"
            }
          },
          "rows": {
            "$state": "/people"
          }
        },
        "children": []
      },
      "row2": {
        "type": "Grid",
        "props": {
          "columns": "2"
        },
        "children": [
          "onCallCard",
          "birthdaysCard"
        ]
      },
      "onCallCard": {
        "type": "Card",
        "props": {
          "title": "📟 On call this week"
        },
        "children": [
          "onCall"
        ]
      },
      "onCall": {
        "type": "Table",
        "props": {
          "pageSize": 5,
          "where": {
            "team": {
              "$state": "/team"
            }
          },
          "columns": [
            {
              "key": "day",
              "label": "Day"
            },
            {
              "key": "person",
              "label": "Who"
            },
            {
              "key": "team",
              "label": "Team"
            },
            {
              "key": "phone",
              "label": "Phone",
              "align": "right"
            }
          ],
          "rows": [
            {
              "day": "Mon",
