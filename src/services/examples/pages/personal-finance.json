{
  "name": "personal-finance",
  "title": "November budget",
  "emoji": "💶",
  "description": "A monthly money page: headline numbers, six months of income and spend, then tabs for categories, a searchable paged transactions table, subscriptions with usage bars, and savings goals. Start here for budgets, expenses and anything with many rows.",
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "gap": "lg"
        },
        "children": [
          "head",
          "numbers",
          "flowCard",
          "tabsCard"
        ]
      },
      "head": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "subtitle"
        ]
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/updated"
          },
          "variant": "muted"
        },
        "children": []
      },
      "numbers": {
        "type": "Grid",
        "props": {
          "columns": "4"
        },
        "children": [
          "income",
          "spent",
          "saved",
          "rate"
        ]
      },
      "income": {
        "type": "Metric",
        "props": {
          "label": "Income",
          "value": {
            "$state": "/totals/income"
          },
          "prefix": "€",
          "context": "salary and invoices"
        },
        "children": []
      },
      "spent": {
        "type": "Metric",
        "props": {
          "label": "Spent",
          "value": {
            "$state": "/totals/spent"
          },
          "prefix": "€",
          "change": "-6%",
          "context": "vs October"
        },
        "children": []
      },
      "saved": {
        "type": "Metric",
        "props": {
          "label": "Saved",
          "value": {
            "$state": "/totals/saved"
          },
          "prefix": "€",
          "change": "+14%"
        },
        "children": []
      },
      "rate": {
        "type": "Gauge",
        "props": {
          "label": "Savings rate",
          "value": {
            "$state": "/totals/rate"
          },
          "max": 50,
          "unit": "%",
          "status": "On target",
          "tone": "success"
        },
        "children": []
      },
      "flowCard": {
        "type": "Card",
        "props": {
          "title": "💶 Money in and out",
          "description": "Last six months"
        },
        "children": [
          "flow"
        ]
      },
      "flow": {
        "type": "AreaChart",
        "props": {
          "x": "month",
          "series": [
            {
              "key": "income",
              "label": "Income"
            },
            {
              "key": "spent",
              "label": "Spent"
            }
          ],
          "data": {
            "$state": "/monthly"
          }
        },
        "children": []
      },
      "tabsCard": {
        "type": "Card",
        "props": {},
        "children": [
          "tabs"
        ]
      },
      "tabs": {
        "type": "Tabs",
        "props": {
          "tabs": [
            {
              "label": "📊 Overview"
            },
            {
              "label": "💳 Transactions",
              "count": 57
            },
            {
              "label": "🔁 Subscriptions",
              "count": 5
            },
            {
              "label": "🎯 Goals"
            }
          ]
        },
        "children": [
          "overview",
          "transactions",
          "subs",
          "goals"
        ]
      },
      "overview": {
        "type": "Grid",
        "props": {
          "columns": "2"
        },
        "children": [
          "pie",
          "ranked"
        ]
      },
      "pie": {
        "type": "PieChart",
        "props": {
          "title": "By category",
          "centerLabel": "Spent",
          "data": {
            "$state": "/byCategory"
          }
        },
        "children": []
      },
      "ranked": {
        "type": "RankedList",
        "props": {
          "title": "Where it went",
          "unit": " €",
          "rows": {
            "$state": "/topMerchants"
          }
        },
        "children": []
      },
      "transactions": {
        "type": "DataTable",
        "props": {
          "pageSize": 15,
          "sort": {
            "key": "date",
            "direction": "desc"
          },
          "columns": [
            {
              "key": "date",
              "label": "Date",
              "type": "date"
            },
            {
              "key": "merchant",
              "label": "Merchant"
            },
            {
              "key": "category",
              "label": "Category",
              "type": "badge",
              "tones": {
                "🏠 Rent": "info",
                "🍝 Eating out": "warning",
                "💊 Health": "success"
              }
            },
            {
              "key": "account",
              "label": "Account",
              "show": "wide"
            },
            {
              "key": "amount",
              "label": "Amount",
              "type": "money",
              "currency": "EUR",
              "decimals": 2
            }
          ],
          "rows": {
            "$state": "/transactions"
          },
          "filters": [
            {
              "key": "category",
              "label": "Category"
            },
            {
              "key": "account",
              "label": "Account"
            }
          ]
        },
        "children": []
      },
      "subs": {
        "type": "DataTable",
        "props": {
          "search": false,
          "columns": [
            {
              "key": "name",
              "label": "Subscription"
            },
            {
              "key": "renews",
              "label": "Renews",
              "type": "date"
            },
            {
              "key": "usage",
              "label": "How much I use it",
              "type": "progress"
            },
            {
              "key": "price",
              "label": "Per month",
              "type": "money",
              "currency": "EUR",
              "decimals": 2
            }
          ],
          "rows": {
            "$state": "/subscriptions"
          }
        },
        "children": []
      },
      "goals": {
        "type": "Stack",
        "props": {},
        "children": [
          "g1",
          "g2",
          "g3",
          "goalNote"
        ]
      },
      "g1": {
        "type": "Progress",
        "props": {
          "label": "Emergency fund · €10,000",
          "value": {
            "$state": "/goals/emergency"
          },
          "hint": "€7,400 saved"
        },
        "children": []
      },
      "g2": {
        "type": "Progress",
        "props": {
          "label": "Japan trip · €2,500",
          "value": {
            "$state": "/goals/japan"
          }
        },
        "children": []
      },
      "g3": {
        "type": "Progress",
        "props": {
          "label": "New laptop · €1,800",
          "value": {
            "$state": "/goals/laptop"
          }
        },
        "children": []
      },
      "goalNote": {
        "type": "Alert",
        "props": {
          "title": "Two subscriptions you barely use",
          "description": "iCloud 2 TB and the gym cost €52 a month together.",
          "variant": "warning"
        },
        "children": []
      }
    },
