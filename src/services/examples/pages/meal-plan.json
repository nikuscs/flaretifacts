{
  "name": "meal-plan",
  "title": "Meals this week",
  "emoji": "🥗",
  "description": "A weekly plan with one tab per day (seven tabs), a shopping checklist that saves, and recipes in an accordion. Start here for weekly plans, schedules, routines and anything split by day.",
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "gap": "lg"
        },
        "children": [
          "head",
          "numbers",
          "habits",
          "tabsCard",
          "row"
        ]
      },
      "head": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "subtitle"
        ]
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "23 to 29 November · cooking for two",
          "variant": "muted"
        },
        "children": []
      },
      "numbers": {
        "type": "KeyNumbers",
        "props": {
          "items": [
            {
              "label": "Dinners at home",
              "value": 6,
              "suffix": "/7"
            },
            {
              "label": "Groceries",
              "value": {
                "$state": "/groceries"
              },
              "prefix": "€",
              "context": "estimated"
            },
            {
              "label": "Vegetarian days",
              "value": 3
            },
            {
              "label": "Prep time",
              "value": "5h 20",
              "context": "total"
            }
          ]
        },
        "children": []
      },
      "tabsCard": {
        "type": "Card",
        "props": {
          "title": "🍽️ Plan"
        },
        "children": [
          "tabs"
        ]
      },
      "tabs": {
        "type": "Tabs",
        "props": {
          "tabs": [
            "Mon",
            "Tue",
            "Wed",
            "Thu",
            "Fri",
            "Sat",
            "Sun"
          ]
        },
        "children": [
          "dayMon",
          "dayTue",
          "dayWed",
          "dayThu",
          "dayFri",
          "daySat",
          "daySun"
        ]
      },
      "dayMon": {
        "type": "List",
        "props": {
          "items": [
            {
              "title": "Overnight oats",
              "meta": "🥐 Breakfast"
            },
            {
              "title": "Chicken caesar wrap",
              "meta": "🥗 Lunch"
            },
            {
              "title": "Salmon, rice and greens",
              "meta": "🍲 Dinner"
            }
          ]
        },
        "children": []
      },
      "dayTue": {
