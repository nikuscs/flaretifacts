      "row": {
        "type": "Grid",
        "props": {
          "columns": "2"
        },
        "children": [
          "shopCard",
          "recipesCard"
        ]
      },
      "shopCard": {
        "type": "Card",
        "props": {
          "title": "🛒 Shopping list",
          "description": "Tick as you shop"
        },
        "children": [
          "shop"
        ]
      },
      "shop": {
        "type": "Checklist",
        "props": {
          "items": {
            "$bindState": "/shopping"
          }
        },
        "children": []
      },
      "recipesCard": {
        "type": "Card",
        "props": {
          "title": "👩‍🍳 Recipes"
        },
        "children": [
          "recipes"
        ]
      },
      "recipes": {
        "type": "Accordion",
        "props": {
          "items": [
            {
              "title": "Bacalhau à Brás",
              "icon": "utensils"
            },
            {
              "title": "Chilli con carne",
              "icon": "utensils"
            },
            {
              "title": "Overnight oats",
              "icon": "coffee"
            }
          ]
        },
        "children": [
          "r1",
          "r2",
          "r3"
        ]
      },
      "r1": {
        "type": "Markdown",
        "props": {
          "text": "**30 min · serves 2**\n\n1. Soak and shred 300 g salted cod.\n2. Fry 400 g matchstick potatoes and one sliced onion.\n3. Stir in the cod, then 4 beaten eggs off the heat.\n4. Finish with black olives and parsley."
        },
        "children": []
      },
      "r2": {
        "type": "Markdown",
        "props": {
          "text": "**1 h · serves 4**\n\nBrown 500 g mince with onion, garlic, cumin and smoked paprika. Add chopped tomatoes, kidney beans and a square of dark chocolate. Simmer 40 minutes."
        },
        "children": []
      },
      "r3": {
        "type": "Markdown",
        "props": {
          "text": "**5 min + overnight**\n\nMix 50 g oats, 120 ml milk, a spoon of chia and yogurt. Top with berries in the morning."
        },
        "children": []
      },
      "habits": {
        "type": "Grid",
        "props": {
          "columns": "3"
        },
        "children": [
          "habitVeg",
          "habitFish",
          "habitPizza"
        ]
      },
      "habitVeg": {
        "type": "Icon",
        "props": {
          "icon": "sprout",
          "label": "Veggie twice",
          "description": "Tuesday and Thursday",
          "tone": "success"
        },
        "children": []
      },
      "habitFish": {
        "type": "Icon",
        "props": {
          "icon": "flame",
          "label": "Fish on the grill",
          "description": "Saturday sardines",
          "tone": "warning"
        },
        "children": []
      },
      "habitPizza": {
        "type": "Icon",
        "props": {
          "icon": "pizza",
          "label": "Pizza Friday",
          "description": "Dough on Thursday night",
          "tone": "info"
        },
        "children": []
      }
    },
    "state": {
      "groceries": 86,
      "shopping": [
        {
          "title": "Salted cod 300 g"
        },
        {
          "title": "Eggs (12)",
