{
  "name": "seller-directory",
  "title": "Seller directory",
  "emoji": "🛍️",
  "description": "A big lookup table: a DataTable of 40 shops whose rows open on click. Short columns stay in the table (seller linked to its store with urlKey, a status badge with tones and emoji, a rating); brands show only on wide screens and what they are good at plus the store link only in the row's panel. The panel also holds blocks for that row: the mentions of that seller, stored once in /mentions as a short { keys, rows } list and joined with where and $item, and a Notes box saved onto the row with $bindItem. Three select filters, pages and KeyNumbers above. Start here for directories, catalogues, vendor or seller lists and any table people search and filter.",
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "gap": "lg"
        },
        "children": [
          "intro",
          "numbers",
          "sellersCard"
        ]
      },
      "intro": {
        "type": "Text",
        "props": {
          "text": "Independent vintage and resale shops, checked by hand. Updated 18 Nov. Filter by brand, style or status; best rated first.",
          "variant": "muted"
        },
        "children": []
      },
      "numbers": {
        "type": "KeyNumbers",
        "props": {
          "items": [
            {
              "label": "Sellers",
              "value": {
                "$state": "/stats/sellers"
              }
            },
            {
              "label": "Live now",
              "value": {
                "$state": "/stats/live"
              },
              "context": "🟢 checked this month"
            },
            {
              "label": "Brands",
              "value": {
                "$state": "/stats/brands"
              },
              "context": "across all shops"
            },
            {
              "label": "Average rating",
              "value": {
                "$state": "/stats/rating"
              },
              "suffix": "/5"
            }
          ]
        },
        "children": []
      },
      "sellersCard": {
        "type": "Card",
        "props": {
          "title": "🛍️ Sellers",
          "description": "Search, sort, or filter by brand, style and status"
        },
        "children": [
          "sellers"
        ]
      },
      "sellers": {
        "type": "DataTable",
        "props": {
          "columns": [
            {
              "key": "seller",
              "label": "Seller",
              "urlKey": "store"
            },
            {
              "key": "brands",
              "label": "Brands",
              "show": "wide"
            },
            {
              "key": "style",
              "label": "Style",
              "type": "badge",
              "show": "wide"
            },
            {
              "key": "status",
              "label": "Status",
              "type": "badge",
              "tones": {
                "🟢 Live": "success",
                "🔒 Invite only": "warning",
                "❔ Not checked": "neutral"
              }
            },
            {
              "key": "rating",
              "label": "Rating",
              "type": "number",
              "decimals": 1,
              "show": "wide"
            },
            {
              "key": "goodAt",
              "label": "Good at",
              "show": "detail"
            },
            {
              "key": "store",
              "label": "Store",
              "type": "link",
              "show": "detail",
              "copy": true
            }
          ],
          "rows": {
            "$state": "/sellers"
          },
          "filters": [
            {
              "key": "brands"
            },
            {
              "key": "style",
              "options": [
                {
                  "value": "Streetwear",
                  "emoji": "🧢"
                },
                {
                  "value": "Luxury",
                  "emoji": "💎"
                },
                {
                  "value": "Outdoor",
                  "emoji": "🏔️"
                },
                {
                  "value": "Basics",
                  "emoji": "👕"
                },
                {
                  "value": "Sneakers",
                  "emoji": "👟"
                }
              ]
            },
            {
              "key": "status",
              "options": [
                "🟢 Live",
                "🔒 Invite only",
                "❔ Not checked"
              ]
            }
          ],
          "sort": {
            "key": "rating",
            "direction": "desc"
          },
          "pageSize": 20
        },
        "children": [
          "sellerMentions",
          "sellerNotes"
        ]
      },
      "sellerMentions": {
        "type": "DataTable",
        "props": {
          "title": "What people say",
          "columns": [
            {
              "key": "date",
              "label": "Date",
              "type": "date"
            },
            {
              "key": "where",
              "label": "Where",
              "type": "badge",
              "show": "wide"
            },
            {
              "key": "quote",
              "label": "Quote"
            }
          ],
          "rows": {
            "$state": "/mentions"
          },
          "where": {
            "seller": {
              "$item": "seller"
            }
          },
          "search": false,
          "pageSize": 5,
          "sort": {
            "key": "date",
            "direction": "desc"
          }
        },
        "children": []
      },
      "sellerNotes": {
        "type": "Notes",
        "props": {
          "label": "Your notes",
          "placeholder": "Sizes, prices, what to order next",
          "value": {
            "$bindItem": "notes"
          }
        },
        "children": []
      }
    },
