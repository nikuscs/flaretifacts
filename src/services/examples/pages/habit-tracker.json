{
  "name": "habit-tracker",
  "title": "Habits",
  "emoji": "🔥",
  "description": "A personal tracker: a streak, a sparkline, a goal gauge, a 90-day heatmap and a daily checklist with saved settings. Start here for trackers and personal logs.",
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "gap": "lg"
        },
        "children": [
          "kpis",
          "heatCard",
          "row"
        ]
      },
      "kpis": {
        "type": "Grid",
        "props": {
          "columns": "3"
        },
        "children": [
          "streak",
          "week",
          "goal"
        ]
      },
      "streak": {
        "type": "Stat",
        "props": {
          "label": "Current streak",
          "value": {
            "$state": "/streak"
          },
          "hint": "days in a row"
        },
        "children": []
      },
      "week": {
        "type": "Card",
        "props": {
          "title": "📅 This week"
        },
        "children": [
          "spark"
        ]
      },
      "spark": {
        "type": "Sparkline",
        "props": {
          "label": "Minutes per day",
          "value": "42",
          "change": "+8%",
          "data": {
            "$state": "/minutes"
          }
        },
        "children": []
      },
      "goal": {
        "type": "Card",
        "props": {
          "title": "🎯 Monthly goal"
        },
        "children": [
          "goalGauge"
        ]
      },
      "goalGauge": {
        "type": "Gauge",
        "props": {
          "label": "Workouts",
          "value": {
            "$state": "/workouts"
          },
          "max": 20,
          "status": "Ahead",
          "tone": "success"
        },
        "children": []
      },
      "heatCard": {
        "type": "Card",
        "props": {
          "title": "🔥 Last 90 days"
        },
        "children": [
          "heat"
        ]
      },
      "heat": {
        "type": "Heatmap",
        "props": {
          "days": {
            "$state": "/days"
          },
          "caption": "One square per day"
        },
        "children": []
      },
      "row": {
        "type": "Grid",
        "props": {
          "columns": "2"
        },
        "children": [
          "todayCard",
          "settingsCard"
        ]
      },
      "todayCard": {
        "type": "Card",
        "props": {
          "title": "✅ Today"
        },
        "children": [
          "today"
        ]
      },
      "today": {
        "type": "Checklist",
        "props": {
          "items": {
            "$bindState": "/today"
          }
        },
        "children": []
      },
      "settingsCard": {
        "type": "Card",
        "props": {
          "title": "🔔 Reminders"
        },
        "children": [
          "remind",
          "time"
        ]
      },
      "remind": {
        "type": "Toggle",
        "props": {
          "label": "Morning reminder",
          "checked": {
            "$bindState": "/remind"
          }
        },
        "children": []
      },
      "time": {
        "type": "Select",
        "props": {
          "label": "Time",
          "value": {
            "$bindState": "/time"
          },
          "options": [
            {
              "value": "07:00",
              "label": "07:00"
            },
            {
              "value": "08:00",
              "label": "08:00"
            },
            {
              "value": "09:00",
              "label": "09:00"
            }
          ]
        },
        "children": []
      }
    },
