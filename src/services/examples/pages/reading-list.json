{
  "name": "reading-list",
  "title": "Reading 2026",
  "emoji": "📚",
  "description": "A personal tracker: progress against a goal, tabs for what is being read, what was read (sortable, searchable) and what is next, genres, reading days and a favourite quote. Start here for books, films, courses, collections and habits.",
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "gap": "lg"
        },
        "children": [
          "head",
          "numbers",
          "tabsCard",
          "row",
          "quoteCard"
        ]
      },
      "head": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "subtitle"
        ]
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Goal: 24 books this year",
          "variant": "muted"
        },
        "children": []
      },
      "numbers": {
        "type": "Grid",
        "props": {
          "columns": "3"
        },
        "children": [
          "read",
          "pages",
          "goal"
        ]
      },
      "read": {
        "type": "Metric",
        "props": {
          "label": "Books read",
          "value": {
            "$state": "/stats/read"
          },
          "suffix": " / 24",
          "change": "+3",
          "context": "this month"
        },
        "children": []
      },
      "pages": {
        "type": "Metric",
        "props": {
          "label": "Pages",
          "value": {
            "$state": "/stats/pages"
          },
          "context": "since January"
        },
        "children": []
      },
      "goal": {
        "type": "Card",
        "props": {
          "title": "🏃 Pace"
        },
        "children": [
          "pace"
        ]
      },
      "pace": {
        "type": "Sparkline",
        "props": {
          "label": "Minutes a day",
          "value": "32",
          "change": "+12%",
          "data": {
            "$state": "/stats/minutes"
          }
        },
        "children": []
      },
      "tabsCard": {
        "type": "Card",
        "props": {},
        "children": [
          "tabs"
        ]
      },
      "tabs": {
        "type": "Tabs",
        "props": {
          "tabs": [
            {
              "label": "📖 Reading",
              "count": 2
            },
            {
              "label": "✅ Read",
              "count": 5
            },
            {
              "label": "🔖 Want to read",
              "count": 3
            }
          ]
        },
        "children": [
          "reading",
          "readTable",
          "want"
        ]
      },
      "reading": {
        "type": "Stack",
        "props": {},
        "children": [
          "readingList"
        ]
      },
      "readingList": {
        "type": "DataTable",
        "props": {
          "search": false,
          "columns": [
            {
              "key": "title",
              "label": "Book"
            },
            {
              "key": "author",
              "label": "Author"
            },
            {
              "key": "progress",
              "label": "Progress",
              "type": "progress"
            }
          ],
          "rows": {
            "$state": "/reading"
          }
        },
        "children": []
      },
      "readTable": {
        "type": "DataTable",
        "props": {
          "pageSize": 10,
          "columns": [
            {
              "key": "title",
              "label": "Book"
            },
            {
              "key": "author",
              "label": "Author"
            },
            {
              "key": "genre",
              "label": "Genre",
              "type": "badge"
            },
            {
              "key": "rating",
              "label": "Rating",
              "type": "number"
            },
            {
              "key": "finished",
              "label": "Finished",
              "type": "date"
            }
          ],
          "rows": {
            "$state": "/read"
          }
        },
        "children": []
      },
      "want": {
        "type": "Checklist",
        "props": {
          "items": {
            "$bindState": "/want"
          }
        },
        "children": []
      },
      "row": {
        "type": "Grid",
        "props": {
          "columns": "2"
        },
        "children": [
          "genresCard",
          "daysCard"
        ]
      },
      "genresCard": {
        "type": "Card",
        "props": {
          "title": "🏷️ Genres"
        },
        "children": [
          "genres"
        ]
      },
      "genres": {
        "type": "RankedList",
        "props": {
          "unit": " books",
          "rows": {
            "$state": "/genres"
          }
        },
        "children": []
      },
      "daysCard": {
        "type": "Card",
        "props": {
          "title": "📆 Reading days"
        },
        "children": [
          "heat"
        ]
      },
      "heat": {
        "type": "Heatmap",
        "props": {
          "days": {
            "$state": "/days"
          },
          "caption": "Minutes read per day"
        },
        "children": []
      },
      "quoteCard": {
        "type": "Card",
        "props": {
          "title": "💬 Favourite line so far"
        },
        "children": [
          "quote"
        ]
      },
      "quote": {
        "type": "Quote",
        "props": {
          "text": "You do not rise to the level of your goals. You fall to the level of your systems.",
          "author": "James Clear",
          "source": "Atomic Habits"
        },
        "children": []
      }
    },
    "state": {
