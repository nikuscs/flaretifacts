{
  "name": "sales-pipeline",
  "title": "Sales pipeline",
  "emoji": "🤝",
  "description": "A pipeline people check every morning: key numbers, a Kanban board of deals, value per stage, latest activity and a contacts table grouped by company. Start here for CRMs, job hunts, hiring and any board of cards.",
  "spec": {
    "root": "page",
    "elements": {
      "page": {
        "type": "Stack",
        "props": {
          "gap": "lg"
        },
        "children": [
          "head",
          "numbers",
          "boardCard",
          "row",
          "contactsCard"
        ]
      },
      "head": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "subtitle"
        ]
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "text": "Q4 2026 · deals over €1,000",
          "variant": "muted"
        },
        "children": []
      },
      "numbers": {
        "type": "KeyNumbers",
        "props": {
          "items": [
            {
              "label": "Open deals",
              "value": {
                "$state": "/open"
              }
            },
            {
              "label": "Pipeline",
              "value": {
                "$state": "/pipeline"
              },
              "prefix": "€"
            },
            {
              "label": "Won this quarter",
              "value": {
                "$state": "/won"
              },
              "prefix": "€",
              "context": "62% of target"
            },
            {
              "label": "Win rate",
              "value": 34,
              "suffix": "%"
            }
          ]
        },
        "children": []
      },
      "boardCard": {
        "type": "Card",
        "props": {
          "title": "🗂️ Deals by stage"
        },
        "children": [
          "ownerFilter",
          "board"
        ]
      },
      "board": {
        "type": "Kanban",
        "props": {
          "columns": {
            "$state": "/board"
          },
          "where": {
            "assignee": {
              "$state": "/owner"
            }
          }
        },
        "children": []
      },
      "row": {
        "type": "Grid",
        "props": {
          "columns": "2"
        },
        "children": [
          "stageCard",
          "activityCard"
        ]
      },
      "stageCard": {
        "type": "Card",
        "props": {
          "title": "💰 Value by stage"
        },
        "children": [
          "stages"
        ]
      },
      "stages": {
        "type": "BarChart",
        "props": {
          "x": "stage",
          "series": [
            {
              "key": "value",
              "label": "Value"
            }
          ],
          "unit": "€",
          "data": {
            "$state": "/byStage"
          }
        },
        "children": []
      },
      "activityCard": {
        "type": "Card",
        "props": {
          "title": "⚡ Latest activity"
        },
        "children": [
          "activity"
        ]
      },
      "activity": {
        "type": "Timeline",
        "props": {
          "label": "Activity",
          "events": {
            "$state": "/activity"
          }
        },
        "children": []
      },
      "contactsCard": {
        "type": "Card",
        "props": {
          "title": "👥 Contacts"
        },
        "children": [
          "contacts"
        ]
      },
      "contacts": {
        "type": "DataTable",
        "props": {
          "pageSize": 10,
          "groupBy": "company",
          "columns": [
            {
              "key": "name",
              "label": "Name"
            },
            {
              "key": "company",
              "label": "Company"
            },
            {
              "key": "role",
              "label": "Role"
            },
            {
              "key": "stage",
              "label": "Stage",
              "type": "badge",
              "tones": {
                "🏆 Won": "success",
                "💀 Lost": "danger",
                "📨 Proposal": "info",
                "🤝 Negotiation": "warning"
              }
            },
            {
              "key": "value",
              "label": "Deal",
              "type": "money",
              "currency": "EUR"
            },
            {
              "key": "linkedin",
              "label": "Profile",
              "type": "link",
              "labelKey": "name"
            }
          ],
          "rows": {
            "$state": "/contacts"
          }
        },
        "children": []
      },
      "ownerFilter": {
        "type": "Filters",
        "props": {
          "label": "Owner",
          "all": "Everyone",
          "value": {
            "$bindState": "/owner"
          },
          "options": [
            {
              "value": "Ana",
              "emoji": "🦊",
              "count": 2
            },
            {
              "value": "Liam",
              "emoji": "🐻",
              "count": 3
            },
            {
              "value": "Rita",
              "emoji": "🐼",
              "count": 2
            }
          ]
        },
        "children": []
      }
    },
    "state": {
