{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flaretifacts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_APP_AUDIENCE": "",
    "ACCESS_TEAM_DOMAIN": "",
    "APP_ORIGIN": "",
    "DEV_USER_EMAIL": ""
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "flaretifacts-assets"
    }
  ],
  "services": [
    {
      "binding": "SELF",
      "service": "flaretifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTIFACTS",
        "class_name": "ArtifactsStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArtifactsStore"]
    }
  ]
}
