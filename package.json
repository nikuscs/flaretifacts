{
  "name": "flaretifacts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Artifacts agents create over MCP: block and HTML pages with saved state, versions and public, private or passcode links.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "deploy": "bun scripts/deploy.ts",
    "build": "vite build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:dead": "fallow dead-code",
    "lint:cycles": "fallow architecture --cycles --fail-on-issues",
    "typecheck": "tsrs --noEmit",
    "check": "bun run typecheck && bun run lint && bun run lint:dead && bun run test",
    "agents:sync": "bun .agents/sync.ts",
    "postinstall": "test ! -f .agents/sync.ts || bun run agents:sync"
  },
  "dependencies": {
    "@cf-wasm/og": "0.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@orpc/client": "2.0.0-beta.47",
    "@orpc/contract": "2.0.0-beta.47",
    "@orpc/json-schema": "2.0.0-beta.47",
    "@orpc/mcp": "2.0.0-beta.47",
    "@orpc/openapi": "2.0.0-beta.47",
    "@orpc/server": "2.0.0-beta.47",
    "@orpc/tanstack-query": "2.0.0-beta.47",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "fast-json-patch": "3.1.1",
    "jose": "6.2.14",
    "motion": "14.9.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "streamdown": "^2.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "ts-pattern": "^5.9.2",
    "vinext": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@iconify-json/lucide": "^1.2.150",
    "@shadcn/lint": "0.2.3",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-svg-jsx": "1.3.0",
    "fallow": "3.34.0",
    "oxlint": "^1.89.0",
    "oxlint-plugin-arch": "0.12.2",
    "oxlint-tailwindcss": "^1.16.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "wrangler": "^4.156.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "vinext@1.4.0": "patches/vinext@1.4.0.patch"
  }
}
